generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECNICO
  VISUALIZADOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  // TOTP obligatorio para ADMIN/TECNICO (ver auth/totp.ts). totpSecret queda
  // set desde el paso de setup aunque todavía no esté confirmado — solo
  // totpEnabled=true habilita el login sin volver a pasar por setup.
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  ticketsAssigned Ticket[]        @relation("TicketAssignee")
  vlanReservations VlanReservation[]
  auditLogs      AuditLog[]

  @@map("users")
}

// Sesiones de refresh token. La emisión/rotación real de JWT la implementa
// el prompt de seguridad; este modelo ya deja el contrato de datos listo.
model Session {
  id                String   @id @default(cuid())
  userId            String
  refreshTokenHash  String   @unique
  userAgent         String?
  ipAddress         String?
  revokedAt         DateTime?
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum NodeStatus {
  ONLINE
  OFFLINE
  ADOPTING
  UNKNOWN
}

model NetworkNode {
  id                 String     @id @default(cuid())
  externalId         String     @unique // id crudo del proveedor (UniFi/OPNsense)
  sitio              String
  nombre             String
  modelo             String?
  status             NodeStatus @default(UNKNOWN)
  senalDbm           Int?
  clientesConectados Int        @default(0)
  uptimeSegundos     Int?
  ultimaVezVisto     DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  wifiNetworks WifiNetwork[]
  alerts       Alert[]
  tickets      Ticket[]
  apPlacement  ApPlacement?

  @@index([sitio])
  @@map("network_nodes")
}

model WifiNetwork {
  id                 String   @id @default(cuid())
  nodeId             String?
  sitio              String
  ssid               String
  vlanId             Int
  bandas             String[]
  clientesConectados Int      @default(0)
  throughputMbps     Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  node NetworkNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@unique([sitio, ssid])
  @@map("wifi_networks")
}

enum AlertSeverity {
  INFO
  ADVERTENCIA
  CRITICO
}

model Alert {
  id        String        @id @default(cuid())
  sitio     String
  nodeId    String?
  severidad AlertSeverity
  mensaje   String
  createdAt DateTime      @default(now())
  ticketId  String?

  node   NetworkNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  ticket Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([sitio])
  @@map("alerts")
}

enum VlanReservationStatus {
  RESERVADA
  APLICADA
  LIBERADA
}

model VlanReservation {
  id             String                 @id @default(cuid())
  vlanId         Int
  redSolicitada  String
  sitio          String
  estado         VlanReservationStatus  @default(RESERVADA)
  reservadoPorId String
  planSnapshot   Json // diff propuesto en el momento de la reserva, para auditar contra lo aplicado
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  reservadoPor User     @relation(fields: [reservadoPorId], references: [id])
  tickets      Ticket[]

  // Una reserva activa por VLAN+sitio: la segunda solicitud debe recibir 409,
  // nunca reintentar silenciosamente sobre la misma reserva.
  @@unique([vlanId, sitio, estado])
  @@map("vlan_reservations")
}

enum TicketStatus {
  ABIERTO
  EN_PROGRESO
  ESCALADO
  RESUELTO
}

model Ticket {
  id                String        @id @default(cuid())
  titulo            String
  descripcion       String
  severidad         AlertSeverity
  estado            TicketStatus  @default(ABIERTO)
  nodoAfectadoId    String?
  vlanReservationId String?
  asignadoAId       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  nodoAfectado    NetworkNode?     @relation(fields: [nodoAfectadoId], references: [id], onDelete: SetNull)
  vlanReservation VlanReservation? @relation(fields: [vlanReservationId], references: [id], onDelete: SetNull)
  asignadoA       User?            @relation("TicketAssignee", fields: [asignadoAId], references: [id], onDelete: SetNull)
  alerts          Alert[]
  eventos         TicketEvent[]

  @@index([estado])
  @@index([severidad])
  @@map("tickets")
}

enum TicketEventType {
  CREADO
  NOTIFICADO
  REMEDIACION_INTENTADA
  ESCALADO
  RESUELTO
  REABIERTO
}

model TicketEvent {
  id        String          @id @default(cuid())
  ticketId  String
  tipo      TicketEventType
  detalle   String
  createdAt DateTime        @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_events")
}

// Auditoría de todo lo que toca infraestructura real: quién/qué worker,
// qué tool/función, con qué parámetros, y el resultado. No editable desde
// la aplicación (solo INSERT).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  workerName String // p.ej. "worker-remediation", "chat-orchestrator"
  toolName   String? // nombre de la tool del LLM invocada, si aplica
  parametros Json
  resultado  Json
  exitoso    Boolean
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workerName])
  @@index([createdAt])
  @@map("audit_logs")
}

// --- Mapeo de planos y ubicación de APs ---
// Vocabulario alineado con la operación real de Diktya: Venue = "recinto"
// (plano base reutilizable entre eventos), EventDeployment = el evento en
// sí (ej. "Expomin 2026"), EventZone = cada plano/pabellón/estacionamiento
// que ese evento efectivamente despliega — un evento grande puede tener
// varias zonas, cada una en un recinto distinto y con su propia escala.

enum ApModel {
  U6_MESH // AP de cobertura, exterior/mesh
  U7_CAMPUS // AP de cobertura, alta densidad
  PRO_MAX_24 // switch de rack perimetral, sin radio de cobertura
  FLEX_MINI // switch compacto, sin radio de cobertura
  FLEX // switch, sin radio de cobertura
  FLEX_ULTRA // switch, sin radio de cobertura
}

enum DeploymentEstado {
  PLANIFICACION
  EN_CURSO
  FINALIZADO
}

model Venue {
  id           String   @id @default(cuid())
  nombre       String
  planFilePath String // PDF/imagen del plano base, ruta relativa a uploads/
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  zonas EventZone[]

  @@map("venues")
}

model EventDeployment {
  id        String           @id @default(cuid())
  nombre    String
  fecha     DateTime
  estado    DeploymentEstado @default(PLANIFICACION)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  zonas EventZone[]

  @@map("event_deployments")
}

model EventZone {
  id                String   @id @default(cuid())
  eventDeploymentId String
  venueId           String
  nombreZona        String // ej. "Pabellón 3", "Estacionamiento Norte"
  // Override del plano del Venue (ej. ya anotado con la red de esta zona
  // puntual); si es null se usa el planFilePath del Venue.
  planFilePath      String?
  pixelesPorMetro   Float? // calibración de escala PROPIA de esta zona (ver coverage.service)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  eventDeployment EventDeployment @relation(fields: [eventDeploymentId], references: [id], onDelete: Cascade)
  venue           Venue           @relation(fields: [venueId], references: [id])
  aps             ApPlacement[]

  @@index([eventDeploymentId])
  @@index([venueId])
  @@map("event_zones")
}

model ApPlacement {
  id            String   @id @default(cuid())
  eventZoneId   String
  modelo        ApModel
  // Coordenadas en píxeles sobre el plano renderizado (canvas del frontend),
  // no en metros — se convierten usando pixelesPorMetro de la EventZone.
  x             Float
  y             Float
  radioMetros   Float // default por modelo al crear, editable después
  rackLabel     String? // ej. "Rack 3" — responde qué rack cubre qué área
  // Enlace opcional al equipo real una vez adoptado en UniFi (hoy 0 de 11
  // equipos de borde están adoptados, así que esto normalmente queda null).
  networkNodeId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  eventZone   EventZone    @relation(fields: [eventZoneId], references: [id], onDelete: Cascade)
  networkNode NetworkNode? @relation(fields: [networkNodeId], references: [id], onDelete: SetNull)

  @@index([eventZoneId])
  @@map("ap_placements")
}
