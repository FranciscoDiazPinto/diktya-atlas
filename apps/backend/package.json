{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:test:setup": "tsx --env-file=.env prisma/setupTestDb.ts",
    "worker:monitor": "tsx watch --env-file=.env src/workers/worker-monitor.ts",
    "worker:triage": "tsx watch --env-file=.env src/workers/worker-triage.ts",
    "worker:remediation": "tsx watch --env-file=.env src/workers/worker-remediation.ts",
    "worker:ticket-followup": "tsx watch --env-file=.env src/workers/worker-ticket-followup.ts",
    "worker:autoremediate": "tsx watch --env-file=.env src/workers/worker-autoremediate.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@diktya-atlas/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.0.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "bullmq": "^5.34.6",
    "csv-parse": "^5.6.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "redlock": "^5.0.0-beta.2",
    "undici": "^8.9.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
