# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Postgres ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# --- Redis (BullMQ + locks) ---
REDIS_URL=redis://HOST:PORT

# --- UniFi Controller ---
# UNIFI_MODE=mock usa el cliente simulado sin tocar infraestructura real.
UNIFI_MODE=mock
UNIFI_HOST=
UNIFI_PORT=
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_VERIFY_TLS=true

# --- OPNsense (fase 2) ---
OPNSENSE_HOST=
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=

# --- Proxmox ---
PROXMOX_HOST=
PROXMOX_SVC_ACCOUNT=
PROXMOX_SVC_TOKEN=

# --- Proveedor LLM ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Notificaciones ---
TELEGRAM_BOT_TOKEN=
SLACK_WEBHOOK_URL=
EMAIL_SMTP_URL=
GENERIC_WEBHOOK_URL=

# --- Auth (stub temporal, ver prompt de seguridad) ---
JWT_SECRET=
