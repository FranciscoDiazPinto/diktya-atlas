# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Postgres ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# --- Redis (BullMQ + locks) ---
REDIS_URL=redis://HOST:PORT

# --- Tests (no configurar nada acá, es informativo) ---
# apps/backend/test/setup.ts reescribe DATABASE_URL -> mismo host/user con
# DB "netbot_test", y REDIS_URL -> índice /1, sin importar lo que digan las
# variables de arriba — así `vitest run` nunca toca los datos reales (antes
# del 2026-07-31 sí lo hacía, contaminaba /reports/digest). Antes de correr
# tests por primera vez: `pnpm --filter backend db:test:setup` (crea
# netbot_test, migra, siembra los 3 usuarios dev).

# --- UniFi Controller ---
# UNIFI_MODE=mock usa el cliente simulado sin tocar infraestructura real.
UNIFI_MODE=mock
UNIFI_HOST=
UNIFI_PORT=
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_VERIFY_TLS=true

# --- UniFi OS (API de integraciones, separada de arriba) ---
# Usada por el panel /infra > "UniFi (real)" (solo lectura: sin alarmas/señal
# — esa API pública no las expone, 404 "No endpoint", no 403) Y por la
# escritura real de WLANs (integrations/unifi/liveClient.ts::writeWifiNetwork,
# vía "WiFi Broadcasts" — ahí el nombre cambió respecto a la API clásica).
# Si UNIFI_MODE=live, estas dos variables pasan a ser requeridas también
# para eso, no solo para el panel. UNIFI_OS_VERIFY_TLS=false por defecto
# porque los UDM suelen tener certificado self-signed.
UNIFI_OS_HOST=
UNIFI_API_KEY=
UNIFI_OS_VERIFY_TLS=false

# --- Auto-remediación (services/autoRemediation.service.ts) ---
# AP offline -> intenta reset y, si hace falta, re-adopción antes de crear
# ticket para técnico. Política de Admin (config, no rol de usuario — la
# dispara el sistema, no hay nadie autenticado). Lista separada por comas
# de tipos de dispositivo elegibles: AP,SWITCH,GATEWAY,UPS. Default: solo AP
# (reiniciar un switch/gateway sin confirmación corta todo el sitio).
AUTO_REMEDIATE_DEVICE_TYPES=AP
# Minutos de cooldown antes de reintentar sobre el mismo dispositivo (evita
# loop de reinicios sobre uno que está flapping).
AUTO_REMEDIATE_COOLDOWN_MINUTES=30
# Segundos de espera después de cada intento (reset, luego re-adopción)
# antes de releer el estado y decidir si funcionó.
AUTO_REMEDIATE_WAIT_SECONDS=90

# --- OPNsense ---
# OPNSENSE_MODE=mock usa el cliente simulado (panel de admin, sin tocar
# infraestructura real). OPNSENSE_MODE=live todavía no está implementado
# (fase 2) — tirará error explícito si se intenta usar.
OPNSENSE_MODE=mock
OPNSENSE_HOST=
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=

# --- Proxmox ---
PROXMOX_HOST=
PROXMOX_SVC_ACCOUNT=
PROXMOX_SVC_TOKEN=

# --- Proveedor LLM ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Cualquier modelo de https://openrouter.ai/models, incluidos los gratis
# (sufijo ":free", ej. "meta-llama/llama-3.1-8b-instruct:free"). Los modelos
# gratis suelen ser bastante peores haciendo tool-calling — probar el flujo
# de tools (propose_vlan_plan, create_ticket, etc.) antes de confiar en uno.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Notificaciones ---
# Ambas requeridas juntas para habilitar el canal Telegram (si falta una,
# se deshabilita con warning, ver notification.service.ts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
EMAIL_SMTP_URL=
GENERIC_WEBHOOK_URL=

# --- Auth ---
# Requerido, minimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=
# Fallback de dev que autentica leyendo x-role/x-user-id sin JWT real.
# Se fuerza a false automaticamente si NODE_ENV=production.
ALLOW_DEV_ROLE_HEADER=true
FRONTEND_ORIGIN=http://localhost:5173
