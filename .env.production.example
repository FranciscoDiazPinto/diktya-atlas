# Plantilla de PRODUCCIÓN — ver DEPLOY.md para el runbook completo.
# Copiar a `.env.production` en la máquina dedicada, completar los valores
# reales, y NUNCA commitearlo (ya está en .gitignore junto con `.env`).
#
# Diferencias clave respecto a `.env.example` (desarrollo):
# - NODE_ENV=production fuerza automáticamente ALLOW_DEV_ROLE_HEADER=false
#   y la cookie de refresh `secure=true` (ver config/env.ts) — igual se deja
#   explícito acá abajo para que quede documentado, no solo implícito.
# - DATABASE_URL/REDIS_URL apuntan a los nombres de servicio de
#   docker-compose.prod.yml (`postgres`/`redis`), no a `localhost`.
# - Credenciales de Postgres/Redis/JWT_SECRET deben ser NUEVAS, generadas
#   para este ambiente — nunca las de `netbot`/`netbot` del compose de dev.

# --- Servidor ---
PORT=3000
NODE_ENV=production

# --- Postgres ---
# Las 3 primeras las lee el propio contenedor de Postgres (mismos nombres
# que su imagen oficial espera); DATABASE_URL la usan el backend/workers —
# deliberadamente NO se arma por interpolación de Compose (eso requeriría
# pasar `--env-file` en cada comando, y si alguien lo olvida Postgres
# arrancaría con credenciales vacías en silencio). Mantené el
# usuario/password/db sincronizados entre las dos si los cambiás.
# Usuario/password nuevos, no reusar los de docker-compose.yml (dev).
POSTGRES_USER=netbot_prod
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=netbot
DATABASE_URL=postgresql://netbot_prod:CAMBIAR@postgres:5432/netbot

# --- Redis (BullMQ + locks) ---
# Sin auth (igual que en dev) — mitigado porque en producción ni Postgres ni
# Redis publican puerto al host, solo son alcanzables por la red interna de
# Docker entre los propios contenedores (ver docker-compose.prod.yml).
REDIS_URL=redis://redis:6379

# --- UniFi Controller (Integration API real) ---
# Mismo valor que ya está validado en desarrollo — copiar UNIFI_API_KEY del
# .env actual (o emitir uno nuevo si se prefiere separar dev/prod).
UNIFI_MODE=live
UNIFI_SITE=default
UNIFI_VERIFY_TLS=true
UNIFI_OS_HOST=10.71.111.101:8443
UNIFI_API_KEY=
# OJO: NO escribir "UNIFI_OS_VERIFY_TLS=false" acá — el schema de env usa
# z.coerce.boolean(), que trata CUALQUIER string no vacío como true
# (incluida la palabra "false" en sí misma). La única forma de que quede en
# false es NO setear la variable, dejando que aplique el default del schema
# (false). El UDM real tiene certificado self-signed, así que esto importa
# de verdad — confirmado con un fallo real (DEPTH_ZERO_SELF_SIGNED_CERT) al
# escribirla explícita. Dejar la línea comentada, no como `VAR=false`.
# UNIFI_OS_VERIFY_TLS=

# --- Auto-remediación ---
AUTO_REMEDIATE_DEVICE_TYPES=AP
AUTO_REMEDIATE_COOLDOWN_MINUTES=30
AUTO_REMEDIATE_WAIT_SECONDS=90
AUTO_REMEDIATE_NOTIFY_THRESHOLD_MINUTES=5

# --- OPNsense ---
# Sigue en mock hasta conectar el real (próximo paso, fuera de este deploy).
OPNSENSE_MODE=mock
OPNSENSE_HOST=
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=

# --- Proxmox ---
# Sin caller en el código todavía (gestión de usuarios/roles no tiene UI) —
# dejar vacío hasta que se implemente esa función.
PROXMOX_HOST=
PROXMOX_SVC_ACCOUNT=
PROXMOX_SVC_TOKEN=

# --- Proveedor LLM ---
# De pago — el modelo free (openai/gpt-oss-20b:free) ya falló en tool-calls
# multi-argumento en pruebas, no usar en producción. Este es el default del
# schema (config/env.ts) si se deja sin setear; se deja explícito acá.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Notificaciones ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
EMAIL_SMTP_URL=
GENERIC_WEBHOOK_URL=

# --- Auth ---
# Generar con: openssl rand -hex 32 — distinto al de desarrollo.
JWT_SECRET=
# Explícito aunque NODE_ENV=production ya lo fuerce en el código.
ALLOW_DEV_ROLE_HEADER=false
# Hostname real detrás de Caddy (ver deploy/Caddyfile) — con la topología de
# un solo origen (frontend + /api en el mismo host) esto es defensa en
# profundidad más que algo que se ejercite en el camino normal.
FRONTEND_ORIGIN=https://netbot.diktya.cl

# --- Caddy / TLS (ver deploy/Caddyfile y DEPLOY.md) ---
# Mismo hostname que FRONTEND_ORIGIN, sin protocolo.
NETBOT_DOMAIN=netbot.diktya.cl
# Token de Cloudflare con permiso "Zone:DNS:Edit" sobre la zona diktya.cl
# (no "Global API Key") — DNS-01 no requiere que esta máquina sea alcanzable
# públicamente, solo que pueda crear el TXT de verificación en el DNS.
CF_API_TOKEN=
